# 复制为 .env 并填入真实凭据。.env 已在 .gitignore，绝不入库。
VAP_LLM_PROVIDER=anthropic
VAP_LLM_BASE_URL=https://api.yjs.im/v1
VAP_LLM_MODEL=glm-5.3-flash
VAP_LLM_API_KEY=
VAP_MONITOR_DIR=D:/监控
VAP_KEY_ITEM_IMAGE=D:/监控/关键物品.jpg
VAP_RTSP_URL=
# Headless HTTP 服务鉴权（可选）：非空则 POST /analyze 需 Bearer Token；空=禁用（向后兼容）。
# GET /healthz 永不鉴权（Docker healthcheck 必须可达）。
VAP_HEADLESS_TOKEN=
